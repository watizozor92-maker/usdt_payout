# HTTP 服务监听地址；`:8088` 表示监听所有网卡的 8088 端口
HTTP_ADDR=:8088

# SQLite 数据库路径，用于持久化订单、队列、交易哈希和回调状态
DB_PATH=./data/payout.db

# 商户应用 ID，必须与游戏端代付通道的 `user_code` 一致
APP_ID=game-hall

# 接口签名密钥，必须与游戏端代付通道的 `secret` 一致；建议使用至少 32 位随机字符串
APP_SECRET=2cd69aac529206a75fd1716198ede6655097fa116b66408b0c310a482ba6acbd

# 回调游戏端时携带的校验值，必须与游戏端回调程序要求的 `callKey` 一致
CALLBACK_KEY=123123dsfjkhsdfkh23423sdf

# 回调目标域名或 IP 白名单；多个值用英文逗号分隔，用于限制 notify_url
CALLBACK_ALLOWED_HOSTS=127.0.0.1

# 代付驱动：tron 为真实 TRC20 转账；mock 仅用于联调，不会真实打款
PAYOUT_DRIVER=tron

# TRON 节点 API 地址，默认使用 TronGrid 主网
TRON_API_URL=https://api.trongrid.io

# TronGrid API Key，用于提高接口调用限额；请使用自己的密钥
TRON_API_KEY=50381813-c7d4-447e-b4eb-9ef4826c37a0

# 代付热钱包私钥（64 位十六进制，不带 0x）；严禁提交到版本库
TRON_PRIVATE_KEY=

# TRON 主网 USDT（TRC20）合约地址，一般无需修改
TRON_USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t

# 达到多少个区块确认后才判定转账成功并回调游戏端
TRON_CONFIRMATIONS=20

# 单次等待链上确认的最长时间；超时后继续确认，不会创建第二笔交易
TRON_CONFIRM_TIMEOUT=10m

# 代付订单处理线程数；使用单个热钱包时建议保持为 1
WORKERS=1

# 代付准备或广播失败时的最大尝试次数
MAX_ATTEMPTS=8

# 回调游戏端失败时的最大尝试次数
CALLBACK_MAX_ATTEMPTS=20

# 日志级别，可设置为 debug、info、warn 或 error
LOG_LEVEL=info
